#!/usr/bin/env bash
# Formats the staged C# files with `dotnet format` and stages the result, so CI's format check passes.
# Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r file; do
    files+=("$file")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.cs')

[ "${#files[@]}" -gt 0 ] || exit 0

# Staging the formatted file would also stage edits that are not meant for this commit.
partial=$(git diff --name-only -- "${files[@]}")
if [ -n "$partial" ]; then
    echo "pre-commit: these files have unstaged changes, stage or stash them first so formatting can be applied:" >&2
    echo "$partial" >&2
    exit 1
fi

dotnet format InternetShop.slnx --include "${files[@]}"
git add -- "${files[@]}"
