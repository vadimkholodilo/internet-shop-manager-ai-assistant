{
  "php.suggest.basic": false,
  "php.validate.enable": false,
  "intelephense.files.associations": ["*.php"],
  "intelephense.files.exclude": [
    "**/.git/**",
    "**/.opencart/install/**",
    "**/node_modules/**",
    "**/bin/**",
    "**/obj/**"
  ],
  "search.exclude": {
    ".opencart": true
  },
  "files.associations": {
    "docker-compose*.yml": "dockercompose"
  }
}
